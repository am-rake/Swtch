@@ -0,0 +1,34 @@
+import { CalculatorConfig, PaymentMethod, PhoneCondition } from '../types';
+import { CELLULAR_PLANS } from '../data/plansData';
+
+export const DEFAULT_CALCULATOR_CONFIG: CalculatorConfig = {
+  planId: 'visible-base',
+  condition: 'Certified Refurbished',
+  paymentMethod: 'outright',
+  tradeInIphone11: true
+};
+
+/** One id format for a saved deal, used both when saving and when checking "is this saved?". */
+export function buildDealId(
+  modelId: string,
+  planId: string,
+  paymentMethod: PaymentMethod,
+  condition: PhoneCondition
+): string {
+  return `${modelId}-${planId}-${paymentMethod}-${condition}`;
+}
+
+export function isCarrierFinancing(paymentMethod: PaymentMethod): boolean {
+  return paymentMethod === 'carrier_24' || paymentMethod === 'carrier_36';
+}
+
+/**
+ * Keeps a config internally consistent: unknown plan ids fall back to the first plan, and carrier
+ * financing is dropped on no-contract (prepaid) plans where the UI doesn't offer it.
+ */
+export function normalizeConfig(config: CalculatorConfig): CalculatorConfig {
+  const plan = CELLULAR_PLANS.find((p) => p.id === config.planId) ?? CELLULAR_PLANS[0];
+  const paymentMethod: PaymentMethod =
+    isCarrierFinancing(config.paymentMethod) && plan.contractMonths === 0 ? 'outright' : config.paymentMethod;
+  return { ...config, planId: plan.id, paymentMethod };
+}
