+/* ------------------------------ Input / output cleaning ---------------------------- */
+
+const MAX_FIELD_LENGTH = 80;
+
+/** Request fields end up inside a model prompt, so keep them short, single-line strings. */
+function cleanField(value: unknown, fallback: string): string {
+  if (typeof value !== 'string') return fallback;
+  const cleaned = value
+    .replace(/[\u0000-\u001f\u007f]/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, MAX_FIELD_LENGTH);
+  return cleaned || fallback;
+}
+
+function cleanText(value: unknown, maxLength: number): string {
+  return typeof value === 'string' ? value.slice(0, maxLength) : '';
+}
+
+/** Model output is untrusted: only pass on real http(s) links. */
+function cleanUrl(value: unknown): string | undefined {
+  if (typeof value !== 'string') return undefined;
+  try {
+    const url = new URL(value);
+    return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : undefined;
+  } catch {
+    return undefined;
+  }
+}
